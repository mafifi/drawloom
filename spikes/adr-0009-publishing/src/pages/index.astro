---
import {Content, frontmatter} from '../../../../publishing/workbench-example/article.md';
import {Content as Transcript} from '../../../../publishing/workbench-example/transcript.md';
const media = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/media/`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{frontmatter.title} — Drawloom</title>
    <meta name="description" content={frontmatter.description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href="https://mafifi.github.io/drawloom/" />
  </head>
  <body>
    <a class="skip" href="#article">Skip to article</a>
    <header><a class="wordmark" href="https://mafifi.github.io/drawloom/">Drawloom</a><a href="https://github.com/mafifi/drawloom">GitHub</a></header>
    <main id="article">
      <article>
        <h1>{frontmatter.title}</h1>
        <p class="standfirst">{frontmatter.description}</p>
        <p class="notice">Publishing proof · illustrative example, not a customer case study.</p>
        <figure>
          <video controls playsinline preload="none" width="1280" height="720" poster={`${media}workbench.png`} aria-label="From intent to inspectable work: 18-second silent explanation" aria-describedby="transcript-body">
            <source src={`${media}workbench.mp4`} type="video/mp4" />
            <p>Your browser cannot play this video. <a href={`${media}workbench.mp4`}>Download the animation</a> or read the transcript below.</p>
          </video>
          <figcaption><span>Watch the 18-second explanation</span><a href="#transcript">Read the transcript</a></figcaption>
        </figure>
        <div class="prose"><Content /></div>
        <section class="prose transcript" id="transcript-body" aria-labelledby="transcript"><Transcript /></section>
        <p class="downloads"><a href={`${media}workbench.mp4`} download>Download MP4</a><a href={`${media}workbench.png`} download>Download presentation still</a></p>
      </article>
    </main>
    <footer>An infrastructure thesis, not a production demo.</footer>
  </body>
</html>
<style is:global>
  :root {color-scheme: light; --ink: #111; --muted: #5b5d67; --blue: #1447e6; --paper: #fff; font-family: Arial, Helvetica, sans-serif; background: var(--paper); color: var(--ink);}
  * {box-sizing: border-box;}
  body {margin: 0; font-size: 18px; line-height: 1.65;}
  a {color: var(--blue); text-underline-offset: .22em;}
  a:hover {text-decoration-thickness: 2px;}
  a:focus-visible, video:focus-visible {outline: 3px solid var(--blue); outline-offset: 5px;}
  header {margin: 0 24px; padding: 18px 20px; display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid var(--blue);}
  .wordmark {font: bold 32px Georgia, serif; color: var(--ink); text-decoration: none;}
  main {max-width: 1060px; padding: 36px 30px 50px; margin: auto;}
  h1 {font: bold clamp(36px, 4.2vw, 46px)/1.08 Georgia, serif; letter-spacing: -.035em; margin: 0 0 18px;}
  .standfirst {font-size: clamp(20px, 2vw, 25px); line-height: 1.4; color: var(--muted); margin: 0 0 14px;}
  .notice {color: var(--muted); font-size: 16px; margin: 0 0 24px;}
  figure {margin: 0 0 38px;}
  video {display: block; width: 100%; height: auto; aspect-ratio: 16/9; border: 1px solid var(--blue); border-radius: 5px; background: white;}
  figcaption {display: flex; flex-wrap: wrap; gap: 8px 32px; color: var(--blue); font-size: 16px; margin-top: 12px;}
  h2 {font: bold 32px/1.2 Georgia, serif; letter-spacing: -.025em; margin: 34px 0 12px;}
  .prose p {margin: 0 0 18px;}
  .transcript {border-top: 1px solid #d8dbe5; margin-top: 38px; scroll-margin-top: 24px;}
  .downloads {display: flex; flex-wrap: wrap; gap: 10px 30px; font-size: 16px;}
  footer {margin: 0 24px; padding: 20px; border-top: 1px solid var(--blue); color: var(--muted); font-size: 15px;}
  .skip {position: absolute; top: -80px; left: 24px; background: white; padding: 8px; z-index: 2;}
  .skip:focus {top: 8px;}
  @media (max-width: 600px) {header {margin: 0 16px; padding: 16px 0;} .wordmark {font-size: 27px;} main {padding: 28px 20px 36px;} body {font-size: 17px;} h2 {font-size: 29px;} footer {margin: 0 16px; padding: 18px 4px;}}
</style>

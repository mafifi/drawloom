{
  "name": "drawloom",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.23",
  "engines": {
    "node": ">=22"
  },
  "drawloom": {
    "releaseVersion": "0.0.0",
    "dependencyPolicy": {
      "exceptions": []
    }
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*/*"
    ],
    "catalog": {
      "zod": "^4.5.4"
    }
  },
  "scripts": {
    "check": "bun run check:ci",
    "check:ci": "bun run check:dependency-policy && bun run check:types && bun run test",
    "check:dependency-policy": "bun run scripts/check-dependency-policy.ts",
    "check:types": "tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "1.2.23",
    "@types/node": "20.19.19",
    "typescript": "5.9.3"
  }
}

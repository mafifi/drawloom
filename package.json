{
  "name": "drawloom",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.23",
  "engines": {
    "node": ">=22"
  },
  "drawloom": {
    "releaseVersion": "0.0.0",
    "dependencyPolicy": {
      "exceptions": []
    }
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*/*"
    ],
    "catalog": {
      "@cedar-policy/cedar-wasm": "4.12.0",
      "casbin": "5.43.0",
      "@microsoft/aspire-cli": "13.5.3",
      "@opentelemetry/api": "1.9.1",
      "@opentelemetry/api-logs": "0.222.0",
      "@opentelemetry/sdk-trace-node": "2.11.0",
      "@opentelemetry/sdk-trace-base": "2.11.0",
      "@opentelemetry/sdk-trace": "2.11.0",
      "@opentelemetry/sdk-logs": "0.222.0",
      "@opentelemetry/sdk-metrics": "2.11.0",
      "@opentelemetry/resources": "2.11.0",
      "@opentelemetry/core": "2.11.0",
      "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
      "@opentelemetry/exporter-logs-otlp-http": "0.222.0",
      "@opentelemetry/exporter-metrics-otlp-http": "0.222.0",
      "@types/bun": "1.2.23",
      "astro": "7.3.1",
      "@astrojs/check": "0.9.10",
      "remotion": "4.0.520",
      "@remotion/cli": "4.0.520",
      "react": "19.2.8",
      "react-dom": "19.2.8",
      "@types/react": "19.2.18",
      "@types/react-dom": "19.2.7",
      "@google/design.md": "^0.4.0",
      "@modelcontextprotocol/sdk": "^1.30.0",
      "@napi-rs/keyring": "2.0.0",
      "@modelcontextprotocol/ext-apps": "1.7.5",
      "dependency-cruiser": "^18.2.0",
      "zod": "^4.5.4",
      "yaml": "2.9.0",
      "svelte": "5.57.0",
      "@sveltejs/kit": "2.70.3",
      "@sveltejs/adapter-static": "3.0.10",
      "@sveltejs/vite-plugin-svelte": "7.3.0",
      "vite": "8.2.2",
      "svelte-check": "4.7.6",
      "@tauri-apps/cli": "2.11.4",
      "@sveltejs/package": "2.5.8",
      "tailwindcss": "4.3.3",
      "@tailwindcss/vite": "4.3.3",
      "clsx": "2.1.1",
      "tailwind-merge": "3.6.0",
      "tw-animate-css": "1.4.0",
      "@internationalized/date": "^3.12.0",
      "@lucide/svelte": "^1.43.0",
      "bits-ui": "^2.16.3",
      "@temporalio/client": "1.23.0",
      "@temporalio/worker": "1.23.0",
      "@temporalio/workflow": "1.23.0",
      "@temporalio/activity": "1.23.0",
      "@temporalio/common": "1.23.0",
      "tailwind-variants": "^3.3.0",
      "svelte-sonner": "^1.1.0",
      "shadcn-svelte": "1.6.1"
    }
  },
  "scripts": {
    "desktop:build": "bun run build:packages && bun run --cwd apps/desktop build",
    "desktop:start": "bun run apps/desktop/host/main.ts",
    "desktop:check": "bun run --cwd apps/desktop check",
    "desktop:tauri": "bun run --cwd apps/desktop tauri build --no-bundle",
    "build:packages": "bun run scripts/build-packages.ts",
    "check:package-artifacts": "bun run scripts/check-package-artifacts.ts",
    "test:node": "node scripts/test-packages-node.mjs",
    "journal:render:article": "remotion render publishing/site/remotion.tsx EpisodeSteps publishing/.generated/media/a-place-to-do-the-work/episode-steps.mp4 --codec=h264 --concurrency=2 && remotion still publishing/site/remotion.tsx EpisodeSteps publishing/.generated/media/a-place-to-do-the-work/episode-steps.png --frame=840",
    "publishing:placeholder": "bun run scripts/stage-publishing-placeholder.ts",
    "journal:build": "bun run scripts/build-journal.ts",
    "journal:preview": "bun run scripts/build-journal.ts --drafts && cd publishing/site && astro preview --host 127.0.0.1 --port 4321",
    "journal:check": "cd publishing/site && astro check && tsc --noEmit -p tsconfig.json",
    "journal:render": "remotion render publishing/site/remotion.tsx Workbench publishing/.generated/media/workbench-example/workbench.mp4 --codec=h264 --concurrency=2 && remotion still publishing/site/remotion.tsx Workbench publishing/.generated/media/workbench-example/workbench.png --frame=450",
    "spike:adr-0009:render": "remotion render spikes/adr-0009-publishing/remotion.tsx Workbench spikes/adr-0009-publishing/public/media/workbench.mp4 --codec=h264 --concurrency=2 && remotion still spikes/adr-0009-publishing/remotion.tsx Workbench spikes/adr-0009-publishing/public/media/workbench.png --frame=450",
    "spike:adr-0009:build": "astro build --root spikes/adr-0009-publishing",
    "spike:adr-0009:verify": "bun run spikes/adr-0009-publishing/verify.mts",
    "spike:adr-0009:studio": "remotion studio spikes/adr-0009-publishing/remotion.tsx --no-open",
    "spike:adr-0009:preview": "cd spikes/adr-0009-publishing && astro preview --host 127.0.0.1",
    "check:publishing-types": "tsc --noEmit -p spikes/adr-0009-publishing/tsconfig.json && bun run journal:check",
    "check": "bun run check:ci",
    "check:ci": "bun run check:dependency-policy && bun run build:packages && bun run check:package-artifacts && bun run desktop:check && bun run --cwd apps/desktop build && bun run check:architecture && bun run check:design && bun run check:types && bun run check:publishing-types && bun run test && bun run test:node",
    "check:ui-policy": "bun run scripts/check-ui-policy.ts",
    "check:architecture": "bun run check:ui-policy && depcruise --config .dependency-cruiser.mjs .",
    "check:dependency-policy": "bun run scripts/check-dependency-policy.ts",
    "check:design": "designmd lint DESIGN.md && designmd lint publishing/DESIGN.md",
    "check:types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p spikes/adr-0017-orchestration/tsconfig.portable.json && tsc --noEmit -p spikes/adr-0017-orchestration/tsconfig.temporal.json && tsc --noEmit -p packages/orchestration/temporal-orchestration/tsconfig.tests.json",
    "test:temporal": "DRAWLOOM_TEMPORAL_TEST=1 node --test --test-concurrency=1 packages/orchestration/temporal-orchestration/real.test.mjs packages/orchestration/temporal-orchestration/installed-host.test.mjs",
    "test:temporal:compiled": "bun run build:packages && bun run scripts/stage-temporal-runtime.ts && DRAWLOOM_TEMPORAL_COMPILED=1 node --test packages/orchestration/temporal-orchestration/compiled-runtime.test.mjs",
    "test": "bun --conditions=svelte test",
    "spike:adr-0005": "bun run spikes/adr-0005-tool-exposure/run-live-spike.ts",
    "spike:adr-0007": "bun run spikes/adr-0007-codex-app-server/run-live.ts",
    "spike:adr-0008": "bun run spikes/adr-0008-tool-execution/run-live.ts",
    "spike:adr-0017": "bun run build:packages && node --experimental-strip-types --test spikes/adr-0017-orchestration/temporal-host.test.ts && bun build spikes/adr-0017-orchestration/temporal-worker.ts --target node --packages external --outdir spikes/adr-0017-orchestration/dist && node --experimental-strip-types spikes/adr-0017-orchestration/temporal-run.ts"
  },
  "devDependencies": {
    "@cedar-policy/cedar-wasm": "catalog:",
    "casbin": "catalog:",
    "@microsoft/aspire-cli": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/api-logs": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@opentelemetry/sdk-logs": "catalog:",
    "@opentelemetry/sdk-metrics": "catalog:",
    "yaml": "catalog:",
    "@temporalio/client": "catalog:",
    "@temporalio/worker": "catalog:",
    "@temporalio/workflow": "catalog:",
    "@temporalio/activity": "catalog:",
    "@temporalio/common": "catalog:",
    "svelte": "catalog:",
    "astro": "catalog:",
    "@astrojs/check": "catalog:",
    "remotion": "catalog:",
    "@remotion/cli": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@google/design.md": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "@modelcontextprotocol/ext-apps": "catalog:",
    "@types/bun": "1.2.23",
    "@types/node": "20.19.19",
    "dependency-cruiser": "catalog:",
    "typescript": "5.9.3",
    "zod": "catalog:"
  },
  "patchedDependencies": {
    "@modelcontextprotocol/sdk@1.30.0": "patches/@modelcontextprotocol%2Fsdk@1.30.0.patch"
  }
}

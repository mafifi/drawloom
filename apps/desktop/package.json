{
  "name": "@drawloom/desktop",
  "version": "0.0.0",
  "private": true,
  "files": [
    "package.json"
  ],
  "type": "module",
  "drawloom": {
    "role": "composition",
    "runtime": "node"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "catalog:"
  },
  "scripts": {
    "bundle:icon": "node ../../scripts/build-app-icon.ts",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "tauri": "tauri",
    "bundle:host": "pnpm --filter ./../.. run build:packages && rm -rf src-tauri/binaries && pnpm --filter @drawloom/desktop deploy --prod --node-linker=hoisted src-tauri/binaries/host && pnpm --filter @drawloom/temporal-orchestration deploy --prod --node-linker=hoisted src-tauri/binaries/orchestration && node ../../scripts/prune-orchestration-sidecar-runtime.mjs src-tauri/binaries/orchestration && pnpm --filter @drawloom/local-knowledge-runtime deploy --prod --node-linker=hoisted src-tauri/binaries/knowledge && esbuild host/main.ts --bundle --platform=node --format=esm --external:@napi-rs/keyring --banner:js='import { createRequire as __drawloomRequire } from \"node:module\"; const require = __drawloomRequire(import.meta.url);' --outfile=src-tauri/binaries/host/host/main.mjs && node ../../scripts/stage-node-runtime.ts src-tauri/binaries/host/host && node ../../scripts/check-bundled-licenses.ts"
  },
  "devDependencies": {
    "@drawloom/agent": "workspace:*",
    "@drawloom/authorization": "workspace:*",
    "@drawloom/authorization-scheduler": "workspace:*",
    "@drawloom/braintrust-assessment": "workspace:*",
    "@drawloom/codex-agent": "workspace:*",
    "@drawloom/codex-assessment": "workspace:*",
    "@drawloom/context": "workspace:*",
    "@drawloom/conversation-history": "workspace:*",
    "@drawloom/default-context": "workspace:*",
    "@drawloom/desktop-host": "workspace:*",
    "@drawloom/evaluation": "workspace:*",
    "@drawloom/evaluation-orchestration": "workspace:*",
    "@drawloom/git-knowledge-source": "workspace:*",
    "@drawloom/host": "workspace:*",
    "@drawloom/knowledge": "workspace:*",
    "@drawloom/local-authorization": "workspace:*",
    "@drawloom/local-knowledge-runtime": "workspace:*",
    "@drawloom/local-plugin-packages": "workspace:*",
    "@drawloom/local-tools": "workspace:*",
    "@drawloom/nightloom": "workspace:*",
    "@drawloom/node-host": "workspace:*",
    "@drawloom/orchestration": "workspace:*",
    "@drawloom/otel-host": "workspace:*",
    "@drawloom/plugins": "workspace:*",
    "@drawloom/replacement-examples": "workspace:*",
    "@drawloom/sqlite-conversation-history": "workspace:*",
    "@drawloom/sqlite-evaluation": "workspace:*",
    "@drawloom/sqlite-knowledge": "workspace:*",
    "@drawloom/startup-plugins": "workspace:*",
    "@drawloom/synthetic-agent": "workspace:*",
    "@drawloom/temporal-orchestration": "workspace:*",
    "@drawloom/tools": "workspace:*",
    "@drawloom/ui": "workspace:*",
    "@drawloom/workbench": "workspace:*",
    "@hono/node-server": "catalog:",
    "@modelcontextprotocol/ext-apps": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/api-logs": "catalog:",
    "@opentelemetry/exporter-trace-otlp-http": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@opentelemetry/sdk-trace-node": "catalog:",
    "@sveltejs/adapter-static": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tauri-apps/cli": "catalog:",
    "@types/mime-types": "catalog:",
    "esbuild": "catalog:",
    "mime-types": "catalog:",
    "playwright": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "vite": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  }
}

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The UI shell requires NO entitlements, and is signed with this empty set.

       It is Rust and does not compile code at runtime. Its WKWebView executes
       JavaScript in Apple's separate WebContent process, which carries its own
       entitlements from the system: the embedding application does not need
       `allow-jit` on its behalf.

       The host is different and is signed separately with
       `host-entitlements.plist`, because the Node runtime it executes does JIT
       in-process. Keeping the two apart means an exception granted for the
       runtime is not silently extended to the process that owns the window and
       the native browser.

       `tauri.conf.json` names this file, so the build-time signature and the
       release signature agree. -->
</dict>
</plist>

{
  "name": "@drawloom/nightloom",
  "version": "0.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "drawloom-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./workflows": {
      "drawloom-source": "./src/workflows.ts",
      "types": "./dist/workflows.d.ts",
      "import": "./dist/workflows.js"
    }
  },
  "drawloom": {
    "role": "consumer",
    "runtime": "portable"
  },
  "dependencies": {
    "@drawloom/knowledge": "workspace:*",
    "@drawloom/orchestration": "workspace:*",
    "zod": "catalog:"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  }
}

{
  "name": "@drawloom/sqlite-knowledge",
  "version": "0.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "drawloom-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:node": "node --experimental-strip-types --test sqlite-knowledge.node-check.ts"
  },
  "drawloom": {
    "role": "provider",
    "runtime": "node"
  },
  "dependencies": {
    "@drawloom/knowledge": "workspace:*",
    "sqlite-vec": "catalog:",
    "zod": "catalog:",
    "@drawloom/authorization": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  }
}

{
  "name": "@drawloom/knowledge",
  "version": "0.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "drawloom-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./conformance": {
      "drawloom-source": "./src/conformance.ts",
      "types": "./dist/conformance.d.ts",
      "import": "./dist/conformance.js"
    },
    "./learning-conformance": {
      "drawloom-source": "./src/learning-conformance.ts",
      "types": "./dist/learning-conformance.d.ts",
      "import": "./dist/learning-conformance.js"
    },
    "./learning": {
      "drawloom-source": "./src/learning.ts",
      "types": "./dist/learning.d.ts",
      "import": "./dist/learning.js"
    },
    "./consent": {
      "drawloom-source": "./src/consent.ts",
      "types": "./dist/consent.d.ts",
      "import": "./dist/consent.js"
    }
  },
  "drawloom": {
    "role": "contract",
    "runtime": "portable"
  },
  "dependencies": {
    "zod": "catalog:",
    "@drawloom/authorization": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  }
}

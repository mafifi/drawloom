{
  "name": "@drawloom/agent",
  "version": "0.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./delegation-conformance": {
      "bun": "./src/delegation-conformance.ts",
      "types": "./dist/delegation-conformance.d.ts",
      "import": "./dist/delegation-conformance.js"
    },
    "./planning-conformance": {
      "bun": "./src/planning-conformance.ts",
      "types": "./dist/planning-conformance.d.ts",
      "import": "./dist/planning-conformance.js"
    },
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./approval-presentation": {
      "bun": "./src/approval-presentation.ts",
      "types": "./dist/approval-presentation.d.ts",
      "import": "./dist/approval-presentation.js"
    },
    "./approval-conformance": {
      "bun": "./src/approval-conformance.ts",
      "types": "./dist/approval-conformance.d.ts",
      "import": "./dist/approval-conformance.js"
    },
    "./conformance": {
      "bun": "./src/conformance.ts",
      "types": "./dist/conformance.d.ts",
      "import": "./dist/conformance.js"
    },
    "./goals-conformance": {
      "bun": "./src/goals-conformance.ts",
      "types": "./dist/goals-conformance.d.ts",
      "import": "./dist/goals-conformance.js"
    }
  },
  "drawloom": {
    "role": "contract",
    "runtime": "portable"
  },
  "dependencies": {
    "@drawloom/conversation-history": "workspace:*",
    "zod": "catalog:",
    "@drawloom/context": "workspace:*",
    "@drawloom/host": "workspace:*",
    "@drawloom/tools": "workspace:*"
  }
}

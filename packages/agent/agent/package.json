{
  "name": "@drawloom/agent",
  "version": "0.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./conformance": {
      "bun": "./src/conformance.ts",
      "types": "./dist/conformance.d.ts",
      "import": "./dist/conformance.js"
    }
  },
  "drawloom": {
    "role": "contract",
    "runtime": "portable"
  },
  "dependencies": {
    "@drawloom/conversation-history": "workspace:*",
    "zod": "catalog:",
    "@drawloom/context": "workspace:*",
    "@drawloom/host": "workspace:*",
    "@drawloom/tools": "workspace:*"
  }
}

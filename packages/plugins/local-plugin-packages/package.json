{
  "name": "@drawloom/local-plugin-packages",
  "version": "0.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "drawloom-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "drawloom": {
    "role": "provider",
    "runtime": "node"
  },
  "dependencies": {
    "@drawloom/plugins": "workspace:*",
    "@drawloom/tools": "workspace:*",
    "@modelcontextprotocol/sdk": "catalog:",
    "@opentelemetry/api": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@drawloom/host": "workspace:*",
    "@hono/node-server": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@opentelemetry/sdk-trace-node": "catalog:"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  }
}

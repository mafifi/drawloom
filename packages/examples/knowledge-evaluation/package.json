{
  "name": "@drawloom/knowledge-evaluation",
  "version": "0.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "org.drawloom",
    "src/app",
    "src/fixtures",
    "src/assets.ts",
    "src/client.ts",
    "src/identities.ts",
    "src/index.ts",
    "app.html",
    "plugin.json",
    "mcp.json",
    "README.md"
  ],
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./backend": {
      "bun": "./org.drawloom/backend.js",
      "types": "./org.drawloom/backend.d.ts",
      "import": "./org.drawloom/backend.js"
    },
    "./workflows": {
      "bun": "./org.drawloom/workflows.js",
      "types": "./org.drawloom/workflows.d.ts",
      "import": "./org.drawloom/workflows.js"
    }
  },
  "scripts": {
    "build": "bun run build.ts"
  },
  "drawloom": {
    "role": "composition",
    "runtime": "node"
  },
  "dependencies": {
    "@drawloom/desktop-host": "workspace:*",
    "@drawloom/evaluation": "workspace:*",
    "@drawloom/evaluation-orchestration": "workspace:*",
    "@drawloom/evaluation-presentation": "workspace:*",
    "@drawloom/ui": "workspace:*",
    "@modelcontextprotocol/ext-apps": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "svelte": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "playwright": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:node-runtime",
    "vite": "catalog:"
  }
}

{
  "name": "@drawloom/temporal-orchestration",
  "version": "0.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "drawloom-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agent-bridge": {
      "drawloom-source": "./src/agent-bridge.ts",
      "types": "./dist/agent-bridge.d.ts",
      "import": "./dist/agent-bridge.js"
    }
  },
  "drawloom": {
    "role": "provider",
    "runtime": "node"
  },
  "dependencies": {
    "@drawloom/agent": "workspace:*",
    "@drawloom/host": "workspace:*",
    "@drawloom/orchestration": "workspace:*",
    "@opentelemetry/api": "catalog:",
    "@temporalio/activity": "catalog:",
    "@temporalio/client": "catalog:",
    "@temporalio/common": "catalog:",
    "@temporalio/worker": "catalog:",
    "@temporalio/workflow": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@drawloom/synthetic-agent": "workspace:*",
    "esbuild": "catalog:"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  }
}

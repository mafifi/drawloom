{
  "name": "@drawloom/orchestration",
  "version": "0.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "drawloom-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./conformance": {
      "drawloom-source": "./src/conformance.ts",
      "types": "./dist/conformance.d.ts",
      "import": "./dist/conformance.js"
    },
    "./conformance-fixtures": {
      "drawloom-source": "./src/conformance-fixtures.ts",
      "types": "./dist/conformance-fixtures.d.ts",
      "import": "./dist/conformance-fixtures.js"
    }
  },
  "drawloom": {
    "role": "contract",
    "runtime": "portable"
  },
  "dependencies": {
    "@drawloom/agent": "workspace:*",
    "zod": "catalog:"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  }
}

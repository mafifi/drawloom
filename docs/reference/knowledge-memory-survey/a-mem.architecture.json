    {
      "dot": "cyan",
      "title": "Research mechanism",
      "items": [
        "Neighbour changes wait for index rebuilding.",
        "The content analyzer is not wired into add."
      ]
    },
    {
      "dot": "emerald",
      "title": "Important implementation limits",
      "items": [
        "The main constructor resets an ephemeral index.",
        "An evolution index mismatch can target wrong notes."
      ]
    },
    {
      "dot": "amber",
      "title": "Not a ready durable service",
      "items": [
        "Alternate persistent retrieval is not full recovery.",
        "Deletion does not repair all dependent links."
      ]
    }

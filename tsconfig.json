{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "types": ["node"]
  },
  // `spikes/` is retained Bun evidence (ADR 0034): not built, not run, and not
  // migrated. It cannot type-check under a toolchain with no `bun:test` types,
  // and rewriting it would destroy the record of what was actually tried.
  "include": ["packages/**/*.test.ts", "scripts/**/*.ts"],
  "exclude": [
    "node_modules",
    "spikes/adr-0017-orchestration/temporal*.ts",
    "spikes/adr-0025-evaluation/braintrust.ts",
    "spikes/adr-0025-evaluation/promptfoo.ts",
    "spikes/adr-0025-evaluation/common.ts",
    "spikes/adr-0025-evaluation/conformance.ts",
    "spikes/adr-0025-evaluation/run.ts",
    "spikes/adr-0025-evaluation/audio-run.ts",
    "packages/orchestration/temporal-orchestration/manager.test.ts"
  ]
}

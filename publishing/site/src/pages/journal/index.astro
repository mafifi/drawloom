---
import {getCollection} from 'astro:content';
import Journal from '../../layouts/Journal.astro';
import {exploreEntries} from '../../explore';
const preview = process.env.JOURNAL_DRAFTS === '1';
const articles = (await getCollection('articles', ({data}) => preview || !data.draft))
  .sort((a, b) => (b.data.published ?? '').localeCompare(a.data.published ?? '') || a.id.localeCompare(b.id));
const [featured, ...remaining] = articles;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const steps = await exploreEntries();
const notice = (id: string) => (id === 'workbench-example' ? 'Illustrative example · local preview, not a customer case study.' : 'Draft · local preview');
---
<Journal title="Journal" description="Notes on making AI useful: what worked, what didn't, and why Drawloom exists." section="journal" draft={preview}>
  <section class="home-intro">
    <p class="eyebrow">Notes on making AI useful.</p>
    {featured ? <>
      <h1>{featured.data.title}</h1>
      <p class="deck">{featured.data.description}</p>
      {featured.data.draft && <p class="notice">{notice(featured.id)}</p>}
      <a class="reading-link" href={`${base}/articles/${featured.id}/`}>Read the essay <img class="arrow" src={`${base}/icons/arrow-right.svg`} width="20" height="20" alt="" /></a>
    </> : <><h1>From ideas to useful work.</h1><p class="deck">The first essay is on its way.</p></>}
  </section>
  <img class="weave" src={`${base}/artwork/weave-hero-neutral.png`} width="1689" height="931" alt="" />
  {remaining.length > 0 && <section aria-label="More essays" class="essay-list">{remaining.map((entry) => <article>
    <p class="eyebrow">Essay</p>
    <h2><a href={`${base}/articles/${entry.id}/`}>{entry.data.title}<img class="arrow" src={`${base}/icons/arrow-right.svg`} width="20" height="20" alt="" /></a></h2>
    <p>{entry.data.description}</p>
    {entry.data.draft && <p class="notice">{notice(entry.id)}</p>}
  </article>)}</section>}
  {steps.length > 0 && <section aria-labelledby="how-we-decide" class="essay-list how-we-decide">
    <p class="eyebrow">Behind the scenes</p>
    <h2 id="how-we-decide">How we decide</h2>
    <p>Six short pages on the thinking behind Drawloom, from the principles we started with to the working code.</p>
    <ol>{steps.map((step) => <li><a href={`${base}/${step.id}/`}><span>{String(step.data.step).padStart(2, '0')}</span>{step.data.title}</a> <small>{step.data.question}</small></li>)}</ol>
  </section>}
</Journal>

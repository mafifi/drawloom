---
import '../styles/journal.css';
interface Props {title: string; description: string; section: 'journal' | 'article'; draft?: boolean}
const {title, description, section, draft = false} = Astro.props;
const article = section === 'article';
const home = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const journal = `${home}journal/`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href={`${home}artwork/drawloom/mark.png`} />
    <link rel="apple-touch-icon" href={`${home}artwork/drawloom/mark.png`} />
    <link rel="preload" href={`${home}fonts/LibreCaslonDisplay-Regular.ttf`} as="font" type="font/ttf" crossorigin />
    <title>{title} — Drawloom</title>
    <meta name="description" content={description} />
    {draft && <meta name="robots" content="noindex, nofollow" />}
    {!draft && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="masthead shell">
      <a class="wordmark" href={home}><img src={`${home}artwork/drawloom/mark.png`} width="36" height="36" alt="" />Drawloom</a>
      <nav aria-label="Main"><a href={journal} aria-current={!article ? 'page' : undefined}>{article && <img class="arrow" src={`${home}icons/arrow-left.svg`} width="14" height="14" alt="" />}{article ? 'Back to journal' : 'Journal'}</a></nav>
    </header>
    <main id="main" class="shell"><slot /></main>
    <footer class="shell"><span>Drawloom journal</span><a href="https://github.com/mafifi/drawloom">GitHub</a></footer>
  </body>
</html>
